# Neon connection string — from your Neon project's dashboard, "Connection Details".
# Use the pooled ("-pooler") host; it already includes ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/gaja?sslmode=require

# Any long random string — used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The client origin allowed to call this API with credentials (cookies).
# Local dev default matches `npm run dev -w client`.
CLIENT_ORIGIN=http://localhost:5173

PORT=8787
